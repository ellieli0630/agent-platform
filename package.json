{
  "name": "gather-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server/index.ts",
    "start": "bun server/index.ts",
    "demo": "bun scripts/demo.ts",
    "test": "bun test test/",
    "typecheck": "tsc --noEmit",
    "build": "bun build client/app.tsx --outdir dist --minify",
    "try": "bun --env-file=.env.live scripts/try.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/react": "^6.17.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spectrum-ts": "^12.10.1",
    "playwright-core": "^1.56.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5"
  }
}
